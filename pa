#!/usr/bin/env bash
# pa: Unified Rust CLI entrypoint for PA-Container 2.0
set -euo pipefail

# Resolve symlinks to locate the repository root regardless of where pa is called from
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd "$(dirname "$TARGET")" && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
REPO_DIR="$(cd "$(dirname "$TARGET")" && pwd)"

exec cargo run --quiet --manifest-path "$REPO_DIR/Cargo.toml" -p pa-cli -- "$@"
