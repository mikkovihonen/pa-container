# Fedora Minimal base for transparent inspection proxy
FROM registry.fedoraproject.org/fedora-minimal:45

RUN microdnf install -y --nodocs \
    curl \
    iptables-nft \
    iproute \
    ca-certificates \
    procps-ng \
    jq \
    shadow-utils \
    util-linux \
    python3 \
    python3-pip \
    uv \
 && microdnf clean all

# gosu for stepping down from root in entrypoint
RUN ARCH="$(uname -m)" \
 && case "$ARCH" in x86_64) GOSU_ARCH="amd64" ;; aarch64) GOSU_ARCH="arm64" ;; *) GOSU_ARCH="$ARCH" ;; esac \
 && curl -fsSL -o /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/1.17/gosu-${GOSU_ARCH}" \
 && chmod +x /usr/local/bin/gosu \
 && ln -sf /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/tls/certs/ca-bundle.crt \
 && ln -sf /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/certs/ca-certificates.crt \
 && ln -sf /usr/bin/pip3 /usr/local/bin/pip

RUN ldconfig \
 && python3 --version \
 && pip3 --version \
 && uv --version

ENV UV_PYTHON=/usr/bin/python3
ENV UV_PYTHON_DOWNLOADS=never

RUN useradd -m mitmproxy

COPY pyproject.toml uv.lock /home/mitmproxy/
RUN chown mitmproxy:mitmproxy /home/mitmproxy/pyproject.toml /home/mitmproxy/uv.lock

USER mitmproxy
WORKDIR /home/mitmproxy
RUN uv sync --frozen --no-install-project --no-default-groups --group proxy
RUN timeout 3s /home/mitmproxy/.venv/bin/mitmweb || [ $? -eq 124 ]

USER root
COPY coding-agent-proxy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY coding-agent-proxy/addons/allowlist/allowlist.py /home/mitmproxy/scripts/allowlist.py
COPY coding-agent-proxy/addons/token_replacer/token_replacer.py /home/mitmproxy/scripts/token_replacer.py
COPY coding-agent-proxy/addons/flow_export/flow_export.py /home/mitmproxy/scripts/flow_export.py
COPY coding-agent-proxy/addons/allowlist/allowlist_config.yaml /home/mitmproxy/config/allowlist.yaml
COPY coding-agent-proxy/addons/token_replacer/token_replacer.yaml /home/mitmproxy/config/token_replacer.yaml
RUN chmod -R a+rX /home/mitmproxy/scripts /home/mitmproxy/config
RUN mkdir -p /home/mitmproxy/exports && chown mitmproxy:mitmproxy /home/mitmproxy/exports

ENV ALLOWLIST_CONFIG_PATH=/home/mitmproxy/config/allowlist.yaml
ENV TOKEN_REPLACER_CONFIG_PATH=/home/mitmproxy/config/token_replacer.yaml

EXPOSE 8080 8081

ENTRYPOINT ["/entrypoint.sh"]
