<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <keyboard>
    <default />
    <!-- Disable compositor exit key combinations -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>
    <keybind key="C-A-BackSpace">
      <action name="None" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="None" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Show safe root-menu without exit/poweroff on background right-click -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
