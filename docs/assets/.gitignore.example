# ─────────────────────────────────────────────────────────────────────────────
# pa-container — .gitignore entries for a workspace that runs coding agents
#
# Copy the lines below into your project's .gitignore.
# .pa-container/ holds workspace configuration, credentials, models, and
# runtime state and should not be committed into the repository.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — workspace configuration and runtime state. Never commit.
.pa-container/

# OPTIONAL — scratch directories you mount as tmpfs via config.yaml (tmpfs.paths).
# Their contents live in RAM and never persist across runs, but the (empty)
# mount points can appear in your workspace. Adjust to match the tmpfs.paths you
# configure and your project's toolchain.
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
