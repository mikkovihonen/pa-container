# ─────────────────────────────────────────────────────────────────────────────
# PA-Container 2.0 — .gitignore entries for a project workspace
# ─────────────────────────────────────────────────────────────────────────────

# Local factory cache, runtime state, and logs
.factory/
.cache/pa-container/

# Python virtual environment and caches (if using Python tooling)
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/

# Rust build artifacts
target/
