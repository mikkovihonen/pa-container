#!/bin/bash
# pi-desktop: Unified CLI utility for agent virtual desktop observation and synthetic control.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: pi-desktop <command> [args...]

Commands:
  status                Display virtual desktop, compositor, and stream status
  screenshot [file]     Capture desktop screenshot to PNG (default: /tmp/screenshot.png)
  windows               List active toplevel application windows
  launch <cmd...>       Launch a GUI application on the virtual desktop
  click <x> <y>         Simulate mouse click at (x, y) coordinates
  move <x> <y>          Move mouse cursor to (x, y) coordinates
  type <text>           Type text into the focused window
  key <key...>          Send key event (e.g. Return, Tab, BackSpace, Escape, ctrl+s)
EOF
    exit 1
}

[ $# -gt 0 ] || usage
CMD="$1"
shift

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"

case "$CMD" in
    status)
        echo "=== Virtual Desktop Status ==="
        echo "WAYLAND_DISPLAY: ${WAYLAND_DISPLAY}"
        echo "DISPLAY:         ${DISPLAY}"
        echo "XDG_RUNTIME_DIR: ${XDG_RUNTIME_DIR}"
        if [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
            echo "Compositor:      RUNNING (socket ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY})"
        else
            echo "Compositor:      STOPPED"
        fi
        if command -v wlr-randr >/dev/null 2>&1; then
            echo "Outputs:"
            wlr-randr 2>/dev/null || echo "  (wlr-randr query failed)"
        fi
        ;;

    screenshot)
        OUT_FILE="${1:-/tmp/screenshot.png}"
        mkdir -p "$(dirname "$OUT_FILE")"
        if command -v grim >/dev/null 2>&1; then
            grim "$OUT_FILE"
        elif command -v scrot >/dev/null 2>&1; then
            scrot "$OUT_FILE"
        elif command -v import >/dev/null 2>&1; then
            import -window root "$OUT_FILE"
        else
            echo "ERROR: Neither grim, scrot, nor import is available" >&2
            exit 1
        fi
        echo "Screenshot saved: ${OUT_FILE}"
        ;;

    windows)
        if command -v wlrctl >/dev/null 2>&1; then
            wlrctl toplevel list 2>/dev/null || true
        elif command -v wmctrl >/dev/null 2>&1; then
            wmctrl -l 2>/dev/null || true
        elif command -v xdotool >/dev/null 2>&1; then
            xdotool search --onlyvisible --name "" 2>/dev/null || true
        else
            echo "ERROR: Neither wlrctl, wmctrl, nor xdotool is available" >&2
            exit 1
        fi
        ;;

    launch)
        [ $# -gt 0 ] || { echo "Usage: pi-desktop launch <command...>" >&2; exit 1; }
        nohup "$@" >/dev/null 2>&1 &
        echo "Launched '$*' (pid: $!) on virtual desktop"
        ;;

    click)
        [ $# -ge 2 ] || { echo "Usage: pi-desktop click <x> <y>" >&2; exit 1; }
        X="$1"
        Y="$2"
        if command -v wlrctl >/dev/null 2>&1; then
            wlrctl pointer move "$X" "$Y"
            wlrctl pointer click left
        elif command -v xdotool >/dev/null 2>&1; then
            xdotool mousemove "$X" "$Y" click 1
        else
            echo "ERROR: Neither wlrctl nor xdotool is available" >&2
            exit 1
        fi
        echo "Clicked at ($X, $Y)"
        ;;

    move)
        [ $# -ge 2 ] || { echo "Usage: pi-desktop move <x> <y>" >&2; exit 1; }
        X="$1"
        Y="$2"
        if command -v wlrctl >/dev/null 2>&1; then
            wlrctl pointer move "$X" "$Y"
        elif command -v xdotool >/dev/null 2>&1; then
            xdotool mousemove "$X" "$Y"
        else
            echo "ERROR: Neither wlrctl nor xdotool is available" >&2
            exit 1
        fi
        echo "Moved cursor to ($X, $Y)"
        ;;

    type)
        [ $# -gt 0 ] || { echo "Usage: pi-desktop type <text>" >&2; exit 1; }
        TEXT="$*"
        if command -v wtype >/dev/null 2>&1; then
            wtype "$TEXT"
        elif command -v xdotool >/dev/null 2>&1; then
            xdotool type "$TEXT"
        else
            echo "ERROR: Neither wtype nor xdotool is available" >&2
            exit 1
        fi
        ;;

    key)
        [ $# -gt 0 ] || { echo "Usage: pi-desktop key <key...>" >&2; exit 1; }
        for k in "$@"; do
            if command -v wtype >/dev/null 2>&1; then
                wtype -k "$k"
            elif command -v xdotool >/dev/null 2>&1; then
                xdotool key "$k"
            else
                echo "ERROR: Neither wtype nor xdotool is available" >&2
                exit 1
            fi
        done
        ;;

    *)
        usage
        ;;
esac
