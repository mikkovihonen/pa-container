# Fedora Minimal base for the coding agent runner
FROM registry.fedoraproject.org/fedora-minimal:45 AS runner

# Core OS packages, utilities, and developer runtime libraries
RUN microdnf install -y --nodocs \
    bash \
    coreutils \
    curl \
    findutils \
    gcc-c++ \
    git \
    gzip \
    iproute \
    libatomic \
    libstdc++ \
    ncurses \
    openssl \
    openssl3-libs \
    procps-ng \
    shadow-utils \
    tar \
    unzip \
    util-linux \
    xz \
    jemalloc \
 && microdnf clean all

# gosu for stepping down from root in entrypoint
RUN ARCH="$(uname -m)" \
 && case "$ARCH" in x86_64) GOSU_ARCH="amd64" ;; aarch64) GOSU_ARCH="arm64" ;; *) GOSU_ARCH="$ARCH" ;; esac \
 && curl -fsSL -o /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/1.17/gosu-${GOSU_ARCH}" \
 && chmod +x /usr/local/bin/gosu \
 && ln -sf /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/tls/certs/ca-bundle.crt \
 && ln -sf /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/certs/ca-certificates.crt

# Bootstrap mitmproxy CA certificate into system trust store
RUN mkdir -p /etc/pki/ca-trust/source/anchors /usr/local/share/ca-certificates/extra
COPY --from=pa-container-agent-proxy:local /home/mitmproxy/.mitmproxy/mitmproxy-ca-cert.pem /etc/pki/ca-trust/source/anchors/mitmproxy-ca-cert.crt
RUN cp /etc/pki/ca-trust/source/anchors/mitmproxy-ca-cert.crt /usr/local/share/ca-certificates/extra/mitmproxy-ca-cert.crt \
 && update-ca-trust extract

# Environment contract
ENV PA_CONTAINER=1
ENV PA_CONTAINER_HOST_IP=169.254.1.2
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
ENV REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
ENV CURL_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
ENV NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt
ENV GIT_SSL_CAINFO=/etc/pki/tls/certs/ca-bundle.crt
ENV NODE_USE_SYSTEM_CA=1

ARG AGENT_UID=1000
ARG AGENT_GID=1000

RUN groupadd --gid ${AGENT_GID} agent \
 && useradd --uid ${AGENT_UID} --gid ${AGENT_GID} --create-home --shell /bin/bash agent

COPY coding-agent/entrypoint.sh /usr/local/bin/entrypoint.sh

ARG ROOT_COMMANDS_PATH
ARG LABEL_HASH
ARG PROJECT_HASH=""
ARG PROJECT_PATH=""
ARG BUILD_TIMESTAMP=""

COPY --from=root_commands_path ${ROOT_COMMANDS_PATH} /root/commands.sh
RUN chmod +x /root/commands.sh && /root/commands.sh

WORKDIR /workspace

LABEL pa-container.hash="${LABEL_HASH}"
LABEL pa-container.project.hash="${PROJECT_HASH}"
LABEL pa-container.project.path="${PROJECT_PATH}"
LABEL pa-container.build.time="${BUILD_TIMESTAMP}"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
